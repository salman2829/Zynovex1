# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret (service_role) — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Client auth uses Email OTP (not password).
# In Supabase Dashboard:
# Authentication → Providers → Email → enable Email / OTP
# Authentication → Email Templates → Magic Link: include {{ .Token }} so the OTP code appears in the email
# Site URL / Redirect URLs: http://localhost:3000/auth/callback

# After founders sign up, promote them with supabase/promote-admins.sql
# Admin portal still uses email + password at /admin/login
